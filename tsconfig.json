{
    "extends": [
        "@sapphire/ts-config",
        "@sapphire/ts-config/extra-strict",
        "@sapphire/ts-config/decorators",
        "@sapphire/ts-config/verbatim"
    ],
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "removeComments": true,
        "declaration": false,
        "declarationMap": false,
        "rootDir": "./src",
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/.tsbuildinfo",
        "skipLibCheck": true,
        "lib": ["DOM"],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx"
    },
    "include": ["src"]
}
