generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "mysql"
}

model Setting {
    key   String @id @db.VarChar(255)
    value String @db.Text

    @@map("setting")
}

enum ThreadOpen {
    OPEN
}

enum ThreadSource {
    AMY
    DRAGORY
    KYB3R
}

model Thread {
    id             String       @default(cuid())
    idOpenedBy     String?
    openedByData   String?      @db.Text
    openedByUser   Boolean?
    idRecipient    String
    recipientData  String       @db.Text
    isOpen         ThreadOpen?
    idChannel      String?
    scheduledClose DateTime?
    source         ThreadSource @default(AMY)
    idLegacy       String?
    legacyNumber   Int?
    openedAt       DateTime     @default(now())
    closedAt       DateTime?

    messages ThreadMessage[]

    @@id(id)
    @@unique([idRecipient, isOpen])
    @@unique([idChannel])
    @@unique([source, idLegacy])
    @@index([idChannel])
    @@map("thread")
}

model ThreadMessage {
    id                   String    @default(cuid())
    idMessage            String?
    idThread             String
    idStaff              String?
    idTransferredMessage String?
    idMirrorMessage      String?
    senderData           String    @db.Text
    messageData          String?   @db.Text
    contents             String    @db.Text
    stickersData         String?   @db.Text
    mentionsData         String?   @db.Text
    internal             Boolean
    anonymous            Boolean?
    forwarded            Boolean   @default(false)
    idLegacy             String?
    createdAt            DateTime  @default(now())
    editedAt             DateTime?
    deletedAt            DateTime?

    thread      Thread              @relation(fields: [idThread], references: [id], onDelete: Cascade)
    edits       ThreadMessageEdit[]
    attachments ThreadAttachment[]

    @@id(id)
    @@index([idMessage])
    @@index([idMirrorMessage])
    @@index([idTransferredMessage])
    @@map("thread_message")
}

model ThreadMessageEdit {
    id              String        @id @default(cuid())
    idThreadMessage String
    message         ThreadMessage @relation(fields: [idThreadMessage], references: [id], onDelete: Cascade)
    idEditor        String?
    contents        String        @db.Text
    mentionsData    String?       @db.Text
    createdAt       DateTime      @default(now())

    @@index([idThreadMessage, createdAt])
    @@map("thread_message_edit")
}

model ThreadAttachment {
    id              String
    idThreadMessage String
    name            String
    contentType     String?
    size            Int
    width           Int?
    height          Int?
    spoiler         Boolean
    description     String? @db.Text

    message ThreadMessage @relation(fields: [idThreadMessage], references: [id], onDelete: Cascade)

    @@id([id, idThreadMessage])
    @@map("thread_attachment")
}

model Snippet {
    id        Int            @default(autoincrement())
    content   String         @db.Text
    createdAt DateTime       @default(now())
    aliases   SnippetAlias[]

    @@id(id)
    @@map("snippet")
}

enum SnippetAliasPrimary {
    PRIMARY
}

model SnippetAlias {
    id        Int                  @default(autoincrement())
    idSnippet Int
    alias     String
    isPrimary SnippetAliasPrimary?

    snippet Snippet @relation(fields: [idSnippet], references: [id], onDelete: Cascade)

    @@id(id)
    @@unique([alias])
    @@unique([idSnippet, isPrimary])
    @@map("snippet_alias")
}
