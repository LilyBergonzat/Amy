{
    "name": "amy",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/main.js",
    "private": true,
    "scripts": {
        "prestart": "npm run build",
        "start": "node .",
        "prebuild": "npm run clean",
        "build": "npm run build:tsc && npm run build:css",
        "build:tsc": "tsc",
        "build:css": "tailwindcss -i src/web/css/main.css -o public/styles.css --minify",
        "clean": "rimraf dist",
        "predev": "npm run clean",
        "dev": "concurrently -k -n tsc,css -c cyan,magenta \"npm:watch:tsc\" \"npm:watch:css\"",
        "watch:tsc": "tsc-watch --onSuccess \"node .\"",
        "watch:css": "tailwindcss -i src/web/css/main.css -o public/styles.css --watch",
        "lint": "prettier --check . && eslint src",
        "format": "prettier --write . && eslint --fix src",
        "postinstall": "prisma generate",
        "script:stickers:native:fetch": "node dist/scripts/stickers-native-fetch.js",
        "script:stickers:native:download": "node dist/scripts/stickers-native-download.js",
        "script:stickers:render:lottie": "node dist/scripts/stickers-render-lottie.js",
        "script:stickers:render:apng": "node dist/scripts/stickers-render-apng.js",
        "script:stickers": "npm run script:stickers:native:fetch && npm run script:stickers:native:download && echo Converting... && npm run script:stickers:render:lottie && npm run script:stickers:render:apng && echo Done",
        "script:dump:markdown-ast": "node dist/scripts/dump-markdown-ast.js",
        "script:import:dragory": "node dist/scripts/import-dragory.js"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "@hono/oauth-providers": "^0.9.1",
        "@prisma/adapter-mariadb": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@sapphire/decorators": "^6.0.4",
        "@sapphire/framework": "^5.0.7",
        "@sapphire/plugin-logger": "^4.0.2",
        "@sapphire/plugin-subcommands": "^6.0.3",
        "@sapphire/time-utilities": "^1.7.12",
        "@sapphire/utilities": "^3.15.3",
        "@sentry/node": "^10.38.0",
        "colorette": "^2.0.20",
        "discord-api-types": "^0.38.56",
        "discord-markdown-parser": "^1.3.1",
        "discord.js": "^14.22.1",
        "dotenv": "^16.4.7",
        "dotenv-expand": "^1000.0.0",
        "file-type": "^22.3.0",
        "gifuct-js": "^2.1.2",
        "highlight.js": "^11.12.0",
        "hono": "^4.13.14",
        "knex": "^3.3.0",
        "mysql2": "^3.24.6",
        "sqlite3": "^6.0.1",
        "tslib": "^2.6.2",
        "tsx": "^4.23.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sapphire/prettier-config": "^2.0.0",
        "@sapphire/ts-config": "^5.0.0",
        "@tailwindcss/cli": "^4.3.3",
        "@types/node": "^22.0.0",
        "@types/upng-js": "^2.1.5",
        "concurrently": "^10.0.6",
        "daisyui": "^5.7.50",
        "eslint": "^10.13.0",
        "lottie-web": "^5.13.0",
        "prettier": "^3.2.4",
        "prisma": "^7.10.1",
        "puppeteer": "^25.16.0",
        "rimraf": "^5.0.5",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "tsc-watch": "^7.2.1",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.0.0",
        "upng-js": "^2.1.0"
    },
    "optionalDependencies": {
        "bufferutil": "^4.0.8",
        "zlib-sync": "^0.1.9"
    }
}
